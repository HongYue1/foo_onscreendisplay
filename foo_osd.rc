// foo_osd resources: the preferences page and its four tabs. Coordinates are dialog units.

#include "resource.h"
#include "winres.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
#pragma code_page(1252)

// Preferences style profile (keep every tab consistent with this; see
// foobar2000-component-dev/references/preferences-pages.md):
//   sections : header + etched line, no group boxes, no bold
//   fields   : labels in a left column, one label width per section, colon after
//   rhythm   : check boxes 14 DU apart, field rows 16 DU (18 with push buttons), 12 DU before a
//              new section header
//   hints    : plain text under the control, or beside it for one short fact; units right of
//              the field
//   columns  : one column 7..293, or two: 7..147 and 155..293; content indented 5
//   colours  : hex edit + swatch button that opens the colour picker

// The page: tab strip, the area the tabs are placed in (IDC_PAGE_HOST, never shown) and the
// Preview row that stays visible on every tab. WS_CHILD, no border: foobar2000 parents it.
IDD_OSD_PREFERENCES DIALOGEX 0, 0, 300, 246
STYLE DS_SETFONT | WS_CHILD
FONT 8, "Microsoft Sans Serif", 400, 0, 0x0
BEGIN
    CONTROL         "",IDC_TABS,"SysTabControl32",WS_CLIPSIBLINGS | WS_TABSTOP,7,3,286,17
    LTEXT           "",IDC_PAGE_HOST,0,24,300,198,NOT WS_VISIBLE
    PUSHBUTTON      "Preview",IDC_PREVIEW,7,227,50,14
    LTEXT           "Shows the card using the values on these pages, unsaved.",IDC_STATIC,64,230,229,8
END

// Tabs: child dialogs, 300 x 198, created once and shown one at a time.

IDD_OSD_TAB_GENERAL DIALOGEX 0, 0, 300, 198
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 8, "Microsoft Sans Serif", 400, 0, 0x0
BEGIN
    LTEXT           "Preset:",IDC_STATIC,7,6,40,8
    COMBOBOX        IDC_PRESET,50,4,130,160,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Sets the look only. Text and fonts stay.",IDC_STATIC,186,2,107,16

    LTEXT           "Behaviour",IDC_STATIC,7,28,140,8
    CONTROL         "",IDC_STATIC,"Static",SS_ETCHEDHORZ,7,38,140,1
    CONTROL         "Enable the on-screen display",IDC_ENABLED,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,44,135,10
    CONTROL         "Show when a track starts",IDC_ON_TRACK,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,22,58,125,10
    CONTROL         "Show when paused or resumed",IDC_ON_PAUSE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,22,72,125,10
    CONTROL         "Show when seeking",IDC_ON_SEEK,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,22,86,125,10
    CONTROL         "Only when in the background",IDC_ONLY_UNFOCUSED,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,100,135,10
    CONTROL         "Hide over full-screen apps",IDC_HIDE_FULLSCREEN,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,114,135,10
    CONTROL         "Show on foobar2000's monitor",IDC_FOLLOW_MONITOR,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,128,135,10

    LTEXT           "Placement",IDC_STATIC,155,28,138,8
    CONTROL         "",IDC_STATIC,"Static",SS_ETCHEDHORZ,155,38,138,1
    LTEXT           "Position:",IDC_STATIC,160,46,56,8
    COMBOBOX        IDC_POSITION,219,44,74,100,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Margin:",IDC_STATIC,160,62,56,8
    EDITTEXT        IDC_MARGIN,219,60,28,12,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "px",IDC_STATIC,251,62,42,8
    LTEXT           "Size:",IDC_STATIC,160,78,56,8
    EDITTEXT        IDC_SCALE,219,76,28,12,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "% (50-300)",IDC_STATIC,251,78,42,8
    LTEXT           "Opacity:",IDC_STATIC,160,94,56,8
    EDITTEXT        IDC_OPACITY,219,92,28,12,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "% (30-100)",IDC_STATIC,251,94,42,8
    LTEXT           "Show for:",IDC_STATIC,160,110,56,8
    EDITTEXT        IDC_SECONDS,219,108,28,12,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "seconds",IDC_STATIC,251,110,42,8
END

IDD_OSD_TAB_APPEARANCE DIALOGEX 0, 0, 300, 198
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 8, "Microsoft Sans Serif", 400, 0, 0x0
BEGIN
    LTEXT           "Card",IDC_STATIC,7,4,140,8
    CONTROL         "",IDC_STATIC,"Static",SS_ETCHEDHORZ,7,14,140,1
    LTEXT           "Layout:",IDC_STATIC,12,22,58,8
    COMBOBOX        IDC_LAYOUT,73,20,74,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Background:",IDC_STATIC,12,38,58,8
    COMBOBOX        IDC_BG_MODE,73,36,74,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Custom colour:",IDC_STATIC,12,54,58,8
    EDITTEXT        IDC_BG_HEX,73,52,40,12,ES_AUTOHSCROLL | ES_UPPERCASE
    CONTROL         "",IDC_BG_SWATCH,"Button",BS_OWNERDRAW | WS_TABSTOP,117,52,24,12
    LTEXT           "Border:",IDC_STATIC,12,70,58,8
    COMBOBOX        IDC_BORDER,73,68,74,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Corner radius:",IDC_STATIC,12,86,58,8
    EDITTEXT        IDC_RADIUS,73,84,28,12,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "px",IDC_STATIC,105,86,42,8
    LTEXT           "Art shape:",IDC_STATIC,12,102,58,8
    COMBOBOX        IDC_ART_SHAPE,73,100,74,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Colours and motion",IDC_STATIC,155,4,138,8
    CONTROL         "",IDC_STATIC,"Static",SS_ETCHEDHORZ,155,14,138,1
    LTEXT           "Text colour:",IDC_STATIC,160,22,52,8
    COMBOBOX        IDC_TEXT_MODE,215,20,78,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Custom text:",IDC_STATIC,160,38,52,8
    EDITTEXT        IDC_TEXT_HEX,215,36,40,12,ES_AUTOHSCROLL | ES_UPPERCASE
    CONTROL         "",IDC_TEXT_SWATCH,"Button",BS_OWNERDRAW | WS_TABSTOP,259,36,24,12
    LTEXT           "Accent:",IDC_STATIC,160,54,52,8
    EDITTEXT        IDC_ACCENT_HEX,215,52,40,12,ES_AUTOHSCROLL | ES_UPPERCASE
    CONTROL         "",IDC_ACCENT_SWATCH,"Button",BS_OWNERDRAW | WS_TABSTOP,259,52,24,12
    LTEXT           "Animation:",IDC_STATIC,160,70,52,8
    COMBOBOX        IDC_ANIMATION,215,68,78,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Speed:",IDC_STATIC,160,86,52,8
    EDITTEXT        IDC_ANIM_SPEED,215,84,28,12,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "%",IDC_STATIC,247,86,46,8
    LTEXT           "Bar style:",IDC_STATIC,160,102,52,8
    COMBOBOX        IDC_BAR_STYLE,215,100,78,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Elements",IDC_STATIC,7,124,286,8
    CONTROL         "",IDC_STATIC,"Static",SS_ETCHEDHORZ,7,134,286,1
    CONTROL         "Album art",IDC_SHOW_ART,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,140,135,10
    CONTROL         "Progress bar",IDC_SHOW_PROGRESS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,154,135,10
    CONTROL         "Time labels",IDC_SHOW_TIMES,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,168,135,10
    CONTROL         "Play/pause icon",IDC_SHOW_GLYPH,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,182,135,10
    CONTROL         "Progress bar knob",IDC_SHOW_KNOB,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,160,140,133,10
    CONTROL         "Shadow",IDC_SHADOW,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,160,154,133,10
    CONTROL         "Glossy top edge",IDC_SHEEN,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,160,168,133,10
    CONTROL         "Accent colour from cover art",IDC_ACCENT_COVER,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,160,182,133,10
END

IDD_OSD_TAB_TEXT DIALOGEX 0, 0, 300, 198
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 8, "Microsoft Sans Serif", 400, 0, 0x0
BEGIN
    LTEXT           "Track text",IDC_STATIC,7,4,286,8
    CONTROL         "",IDC_STATIC,"Static",SS_ETCHEDHORZ,7,14,286,1
    LTEXT           "Line 1:",IDC_STATIC,12,22,34,8
    EDITTEXT        IDC_LINE1,49,20,244,12,ES_AUTOHSCROLL
    LTEXT           "Line 2:",IDC_STATIC,12,38,34,8
    EDITTEXT        IDC_LINE2,49,36,244,12,ES_AUTOHSCROLL
    LTEXT           "Line 3:",IDC_STATIC,12,54,34,8
    EDITTEXT        IDC_LINE3,49,52,244,12,ES_AUTOHSCROLL
    LTEXT           "Title formatting. An empty line is left out. Literal brackets need quotes: '('%date%')'",IDC_STATIC,49,66,244,16
    PUSHBUTTON      "Help",IDC_TITLEFORMAT_HELP,49,86,46,14
    PUSHBUTTON      "Default",IDC_TEXT_DEFAULT,99,86,46,14
END

IDD_OSD_TAB_FONTS DIALOGEX 0, 0, 300, 198
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 8, "Microsoft Sans Serif", 400, 0, 0x0
BEGIN
    LTEXT           "Fonts",IDC_STATIC,7,4,286,8
    CONTROL         "",IDC_STATIC,"Static",SS_ETCHEDHORZ,7,14,286,1
    LTEXT           "Line 1 font:",IDC_STATIC,12,23,70,8
    LTEXT           "",IDC_TITLE_FONT,85,23,108,10,SS_NOPREFIX | SS_ENDELLIPSIS
    PUSHBUTTON      "Select...",IDC_TITLE_FONT_PICK,197,20,46,14
    PUSHBUTTON      "Default",IDC_TITLE_FONT_CLEAR,247,20,46,14
    LTEXT           "Lines 2-3 font:",IDC_STATIC,12,41,70,8
    LTEXT           "",IDC_DETAIL_FONT,85,41,108,10,SS_NOPREFIX | SS_ENDELLIPSIS
    PUSHBUTTON      "Select...",IDC_DETAIL_FONT_PICK,197,38,46,14
    PUSHBUTTON      "Default",IDC_DETAIL_FONT_CLEAR,247,38,46,14
    LTEXT           "Default follows your Columns UI font, or the Default UI font. Line 1 is the title; lines 2-3 and the times use the second font. Picked sizes are exact.",IDC_STATIC,12,56,281,24

    LTEXT           "Fallback fonts",IDC_STATIC,7,92,286,8
    CONTROL         "",IDC_STATIC,"Static",SS_ETCHEDHORZ,7,102,286,1
    LTEXT           "Fallback 1:",IDC_STATIC,12,111,70,8
    LTEXT           "",IDC_FALLBACK_TEXT,85,111,108,10,SS_NOPREFIX | SS_ENDELLIPSIS
    PUSHBUTTON      "Select...",IDC_FALLBACK_PICK,197,108,46,14
    PUSHBUTTON      "Clear",IDC_FALLBACK_CLEAR,247,108,46,14
    LTEXT           "Fallback 2:",IDC_STATIC,12,129,70,8
    LTEXT           "",1081,85,129,108,10,SS_NOPREFIX | SS_ENDELLIPSIS
    PUSHBUTTON      "Select...",1084,197,126,46,14
    PUSHBUTTON      "Clear",1087,247,126,46,14
    LTEXT           "Fallback 3:",IDC_STATIC,12,147,70,8
    LTEXT           "",1082,85,147,108,10,SS_NOPREFIX | SS_ENDELLIPSIS
    PUSHBUTTON      "Select...",1085,197,144,46,14
    PUSHBUTTON      "Clear",1088,247,144,46,14
    LTEXT           "Tried in this order for characters the fonts above cannot draw. Only the family is used: size, weight and italic follow the line being drawn. Built-in fallbacks for CJK, symbols and emoji come after these.",IDC_STATIC,12,162,281,24
END
