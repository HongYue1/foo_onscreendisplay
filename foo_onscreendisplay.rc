// foo_onscreendisplay resources: the preferences page and its five tabs. Coordinates are dialog units.

#include "resource.h"
#include "winres.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
#pragma code_page(1252)

// Preferences style profile (keep every tab consistent with this; see
// foobar2000-component-dev/references/preferences-pages.md):
//   sections : header + etched line, no group boxes, no bold
//   fields   : labels in a left column, one label width per section, colon after
//   rhythm   : check boxes 14 DU apart, field rows 16 DU (18 with push buttons), 12 DU before a
//              new section header
//   hints    : plain text under the control, or beside it for one short fact; units right of
//              the field
//   columns  : one column 7..293, or two: 7..147 and 155..293; content indented 5, options that
//              depend on the one above indented 10 more
//   colours  : hex edit + swatch button that opens the colour picker
//   tabs     : General (when and where), Style (the look a preset sets), Elements (what the card
//              contains), Text (what it says), Fonts (what it is written in)

// The page: tab strip, the area the tabs are placed in (IDC_PAGE_HOST, never shown) and the
// Preview row that stays visible on every tab. WS_CHILD, no border: foobar2000 parents it.
IDD_OSD_PREFERENCES DIALOGEX 0, 0, 300, 246
STYLE DS_SETFONT | WS_CHILD
FONT 8, "Microsoft Sans Serif", 400, 0, 0x0
BEGIN
    CONTROL         "",IDC_TABS,"SysTabControl32",WS_CLIPSIBLINGS | WS_TABSTOP,7,3,286,17
    LTEXT           "",IDC_PAGE_HOST,0,24,300,198,NOT WS_VISIBLE
    PUSHBUTTON      "Preview",IDC_PREVIEW,7,227,50,14
    LTEXT           "Shows the card using the values on these pages, unsaved.",IDC_STATIC,64,230,229,8
END

// Tabs: child dialogs, 300 x 198, created once and shown one at a time.

IDD_OSD_TAB_GENERAL DIALOGEX 0, 0, 300, 198
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 8, "Microsoft Sans Serif", 400, 0, 0x0
BEGIN
    LTEXT           "Show the card",IDC_STATIC,7,4,140,8
    CONTROL         "",IDC_STATIC,"Static",SS_ETCHEDHORZ,7,14,140,1
    CONTROL         "Enable the on-screen display",IDC_ENABLED,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,20,135,10
    CONTROL         "When a track starts",IDC_ON_TRACK,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,22,34,125,10
    CONTROL         "When a stream title changes",IDC_ON_STREAM,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,22,48,125,10
    CONTROL         "When paused or resumed",IDC_ON_PAUSE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,22,62,125,10
    CONTROL         "When seeking",IDC_ON_SEEK,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,22,76,125,10

    LTEXT           "Behaviour",IDC_STATIC,155,4,138,8
    CONTROL         "",IDC_STATIC,"Static",SS_ETCHEDHORZ,155,14,138,1
    LTEXT           "Show for:",IDC_STATIC,160,22,56,8
    EDITTEXT        IDC_SECONDS,219,20,28,12,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "seconds",IDC_STATIC,251,22,42,8
    CONTROL         "Keep visible while paused",IDC_HOLD_PAUSED,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,160,38,133,10
    CONTROL         "Wait for the cover art",IDC_WAIT_ART,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,160,52,133,10
    CONTROL         "Fade under the mouse pointer",IDC_FADE_HOVER,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,160,66,133,10
    CONTROL         "Only while in the background",IDC_ONLY_UNFOCUSED,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,160,80,133,10
    CONTROL         "Hide over full-screen apps",IDC_HIDE_FULLSCREEN,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,160,94,133,10

    LTEXT           "Placement",IDC_STATIC,7,116,286,8
    CONTROL         "",IDC_STATIC,"Static",SS_ETCHEDHORZ,7,126,286,1
    LTEXT           "Position:",IDC_STATIC,12,134,50,8
    COMBOBOX        IDC_POSITION,65,132,82,120,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Monitor:",IDC_STATIC,12,150,50,8
    COMBOBOX        IDC_MONITOR,65,148,82,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Margin:",IDC_STATIC,160,134,56,8
    EDITTEXT        IDC_MARGIN,219,132,28,12,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "px",IDC_STATIC,251,134,42,8
    LTEXT           "Size:",IDC_STATIC,160,150,56,8
    EDITTEXT        IDC_SCALE,219,148,28,12,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "% (50-300)",IDC_STATIC,251,150,42,8
END

IDD_OSD_TAB_STYLE DIALOGEX 0, 0, 300, 198
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 8, "Microsoft Sans Serif", 400, 0, 0x0
BEGIN
    LTEXT           "Preset:",IDC_STATIC,7,6,40,8
    COMBOBOX        IDC_PRESET,50,4,138,200,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Save...",IDC_PRESET_SAVE,192,3,48,14
    PUSHBUTTON      "Delete",IDC_PRESET_DELETE,244,3,49,14
    LTEXT           "Sets the look only: text, fonts, placement and behaviour stay.",IDC_STATIC,50,20,243,8

    LTEXT           "Card",IDC_STATIC,7,36,140,8
    CONTROL         "",IDC_STATIC,"Static",SS_ETCHEDHORZ,7,46,140,1
    LTEXT           "Layout:",IDC_STATIC,12,54,58,8
    COMBOBOX        IDC_LAYOUT,73,52,74,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Background:",IDC_STATIC,12,70,58,8
    COMBOBOX        IDC_BG_MODE,73,68,74,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Custom colour:",IDC_STATIC,12,86,58,8
    EDITTEXT        IDC_BG_HEX,73,84,40,12,ES_AUTOHSCROLL | ES_UPPERCASE
    CONTROL         "",IDC_BG_SWATCH,"Button",BS_OWNERDRAW | WS_TABSTOP,117,84,24,12
    LTEXT           "Opacity:",IDC_STATIC,12,102,58,8
    EDITTEXT        IDC_OPACITY,73,100,28,12,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "% (30-100)",IDC_STATIC,105,102,42,8
    LTEXT           "Border:",IDC_STATIC,12,118,58,8
    COMBOBOX        IDC_BORDER,73,116,74,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Corner radius:",IDC_STATIC,12,134,58,8
    EDITTEXT        IDC_RADIUS,73,132,28,12,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "px",IDC_STATIC,105,134,42,8

    LTEXT           "Colours and motion",IDC_STATIC,155,36,138,8
    CONTROL         "",IDC_STATIC,"Static",SS_ETCHEDHORZ,155,46,138,1
    LTEXT           "Text colour:",IDC_STATIC,160,54,52,8
    COMBOBOX        IDC_TEXT_MODE,215,52,78,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Custom text:",IDC_STATIC,160,70,52,8
    EDITTEXT        IDC_TEXT_HEX,215,68,40,12,ES_AUTOHSCROLL | ES_UPPERCASE
    CONTROL         "",IDC_TEXT_SWATCH,"Button",BS_OWNERDRAW | WS_TABSTOP,259,68,24,12
    LTEXT           "Accent:",IDC_STATIC,160,86,52,8
    EDITTEXT        IDC_ACCENT_HEX,215,84,40,12,ES_AUTOHSCROLL | ES_UPPERCASE
    CONTROL         "",IDC_ACCENT_SWATCH,"Button",BS_OWNERDRAW | WS_TABSTOP,259,84,24,12
    CONTROL         "Accent from the cover art",IDC_ACCENT_COVER,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,160,100,133,10
    LTEXT           "Animation:",IDC_STATIC,160,118,52,8
    COMBOBOX        IDC_ANIMATION,215,116,78,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Speed:",IDC_STATIC,160,134,52,8
    EDITTEXT        IDC_ANIM_SPEED,215,132,28,12,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "% (40-300)",IDC_STATIC,247,134,46,8

    LTEXT           "Effects",IDC_STATIC,7,156,286,8
    CONTROL         "",IDC_STATIC,"Static",SS_ETCHEDHORZ,7,166,286,1
    CONTROL         "Shadow",IDC_SHADOW,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,172,135,10
    CONTROL         "Glossy top edge",IDC_SHEEN,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,160,172,133,10
END

IDD_OSD_TAB_ELEMENTS DIALOGEX 0, 0, 300, 198
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 8, "Microsoft Sans Serif", 400, 0, 0x0
BEGIN
    LTEXT           "On the card",IDC_STATIC,7,4,140,8
    CONTROL         "",IDC_STATIC,"Static",SS_ETCHEDHORZ,7,14,140,1
    CONTROL         "Album art",IDC_SHOW_ART,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,20,135,10
    CONTROL         "Play/pause icon",IDC_SHOW_GLYPH,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,34,135,10
    CONTROL         "Progress bar",IDC_SHOW_PROGRESS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,48,135,10
    CONTROL         "Knob on the bar",IDC_SHOW_KNOB,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,22,62,125,10
    CONTROL         "Time labels",IDC_SHOW_TIMES,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,22,76,125,10
    CONTROL         "Time left instead of length",IDC_SHOW_REMAINING,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,32,90,115,10

    LTEXT           "Shapes",IDC_STATIC,155,4,138,8
    CONTROL         "",IDC_STATIC,"Static",SS_ETCHEDHORZ,155,14,138,1
    LTEXT           "Art shape:",IDC_STATIC,160,22,52,8
    COMBOBOX        IDC_ART_SHAPE,215,20,78,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Bar style:",IDC_STATIC,160,38,52,8
    COMBOBOX        IDC_BAR_STYLE,215,36,78,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Presets set these shapes too; change them here after picking one.",IDC_STATIC,160,54,133,16
END

IDD_OSD_TAB_TEXT DIALOGEX 0, 0, 300, 198
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 8, "Microsoft Sans Serif", 400, 0, 0x0
BEGIN
    LTEXT           "Track text",IDC_STATIC,7,4,286,8
    CONTROL         "",IDC_STATIC,"Static",SS_ETCHEDHORZ,7,14,286,1
    LTEXT           "Line 1:",IDC_STATIC,12,22,34,8
    EDITTEXT        IDC_LINE1,49,20,244,12,ES_AUTOHSCROLL
    LTEXT           "Line 2:",IDC_STATIC,12,38,34,8
    EDITTEXT        IDC_LINE2,49,36,244,12,ES_AUTOHSCROLL
    LTEXT           "Line 3:",IDC_STATIC,12,54,34,8
    EDITTEXT        IDC_LINE3,49,52,244,12,ES_AUTOHSCROLL
    LTEXT           "Title formatting. An empty line is left out. Literal brackets need quotes: '('%date%')'. The Compact layout shows lines 1 and 2 only.",IDC_STATIC,49,66,244,16
    PUSHBUTTON      "Help",IDC_TITLEFORMAT_HELP,49,86,46,14
    PUSHBUTTON      "Default",IDC_TEXT_DEFAULT,99,86,46,14
END

IDD_OSD_TAB_FONTS DIALOGEX 0, 0, 300, 198
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 8, "Microsoft Sans Serif", 400, 0, 0x0
BEGIN
    LTEXT           "Fonts",IDC_STATIC,7,4,286,8
    CONTROL         "",IDC_STATIC,"Static",SS_ETCHEDHORZ,7,14,286,1
    LTEXT           "Line 1 font:",IDC_STATIC,12,23,70,8
    LTEXT           "",IDC_TITLE_FONT,85,23,108,10,SS_NOPREFIX | SS_ENDELLIPSIS
    PUSHBUTTON      "Select...",IDC_TITLE_FONT_PICK,197,20,46,14
    PUSHBUTTON      "Default",IDC_TITLE_FONT_CLEAR,247,20,46,14
    LTEXT           "Lines 2-3 font:",IDC_STATIC,12,41,70,8
    LTEXT           "",IDC_DETAIL_FONT,85,41,108,10,SS_NOPREFIX | SS_ENDELLIPSIS
    PUSHBUTTON      "Select...",IDC_DETAIL_FONT_PICK,197,38,46,14
    PUSHBUTTON      "Default",IDC_DETAIL_FONT_CLEAR,247,38,46,14
    LTEXT           "Default follows your Columns UI font, or the Default UI font. Line 1 is the title; lines 2-3 and the times use the second font. Picked sizes are exact.",IDC_STATIC,12,56,281,16
    CONTROL         "Sharper text: ClearType on opaque cards",IDC_CLEARTYPE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,76,281,10

    LTEXT           "Fallback fonts",IDC_STATIC,7,98,286,8
    CONTROL         "",IDC_STATIC,"Static",SS_ETCHEDHORZ,7,108,286,1
    LTEXT           "Fallback 1:",IDC_STATIC,12,117,70,8
    LTEXT           "",IDC_FALLBACK_TEXT,85,117,108,10,SS_NOPREFIX | SS_ENDELLIPSIS
    PUSHBUTTON      "Select...",IDC_FALLBACK_PICK,197,114,46,14
    PUSHBUTTON      "Clear",IDC_FALLBACK_CLEAR,247,114,46,14
    LTEXT           "Fallback 2:",IDC_STATIC,12,135,70,8
    LTEXT           "",1081,85,135,108,10,SS_NOPREFIX | SS_ENDELLIPSIS
    PUSHBUTTON      "Select...",1084,197,132,46,14
    PUSHBUTTON      "Clear",1087,247,132,46,14
    LTEXT           "Fallback 3:",IDC_STATIC,12,153,70,8
    LTEXT           "",1082,85,153,108,10,SS_NOPREFIX | SS_ENDELLIPSIS
    PUSHBUTTON      "Select...",1085,197,150,46,14
    PUSHBUTTON      "Clear",1088,247,150,46,14
    LTEXT           "Tried in this order for characters the fonts above cannot draw. Only the family is used: size, weight and italic follow the line being drawn. Built-in fallbacks for CJK, symbols and emoji come after these.",IDC_STATIC,12,168,281,24
END

IDD_OSD_PRESET_NAME DIALOGEX 0, 0, 220, 74
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Save preset"
FONT 8, "Microsoft Sans Serif", 400, 0, 0x0
BEGIN
    LTEXT           "Name:",IDC_STATIC,7,10,30,8
    EDITTEXT        IDC_PRESET_NAME,40,8,173,12,ES_AUTOHSCROLL
    LTEXT           "Saves the look set on these pages. A preset of yours with the same name is replaced; built-in names are taken.",IDC_STATIC,40,26,173,24
    DEFPUSHBUTTON   "Save",IDOK,109,53,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,163,53,50,14
END
